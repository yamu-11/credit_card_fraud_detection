
import os
import json
import joblib
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.pipeline import Pipeline
from sklearn.compose import ColumnTransformer
from sklearn.preprocessing import StandardScaler
from sklearn.impute import SimpleImputer
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    roc_auc_score,
    average_precision_score,
    confusion_matrix,
    classification_report
)

# Project paths
DATA_PATH = os.getenv("DATA_PATH", "data/creditcard.csv")
MODEL_PATH = "models/fraud_model.joblib"

os.makedirs("models", exist_ok=True)
os.makedirs("reports", exist_ok=True)

# Feature columns
FEATURES = (
    ["Time"] +
    [f"V{i}" for i in range(1, 29)] +
    ["Amount"]
)

TARGET = "Class"

# Load dataset
if not os.path.exists(DATA_PATH):
    raise FileNotFoundError(
        "Dataset not found. Download creditcard.csv "
        "or generate demo data and set DATA_PATH."
    )

df = pd.read_csv(DATA_PATH)

required = FEATURES + [TARGET]

if not set(required).issubset(df.columns):
    raise ValueError("Dataset does not contain all required columns.")

df = df[required].copy()
df[TARGET] = pd.to_numeric(df[TARGET], errors="coerce")
df.dropna(subset=[TARGET], inplace=True)
df[TARGET] = df[TARGET].astype(int)

if df[TARGET].nunique() != 2:
    raise ValueError("Dataset must contain both fraud and legitimate classes.")

X = df[FEATURES]
y = df[TARGET]

print("Dataset loaded successfully")
print("Total transactions:", len(df))
print("Fraud transactions:", int(y.sum()))
print("Legitimate transactions:", int((y == 0).sum()))

# Split dataset
X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

# Preprocessing pipeline
preprocessor = ColumnTransformer([
    ("numeric", Pipeline([
        ("imputer", SimpleImputer(strategy="median")),
        ("scaler", StandardScaler())
    ]), FEATURES)
])

# Define ML algorithms
models = {
    "Logistic Regression": LogisticRegression(
        max_iter=1500,
        class_weight="balanced",
        solver="liblinear",
        random_state=42
    ),

    "Random Forest": RandomForestClassifier(
        n_estimators=120,
        max_depth=14,
        min_samples_leaf=2,
        class_weight="balanced_subsample",
        random_state=42,
        n_jobs=-1
    )
}

results = {}
trained_models = {}

# Train and evaluate
for name, algorithm in models.items():

    print("\nTraining:", name)

    model = Pipeline([
        ("preprocessor", preprocessor),
        ("classifier", algorithm)
    ])

    model.fit(X_train, y_train)

    predictions = model.predict(X_test)
    probabilities = model.predict_proba(X_test)[:, 1]

    metrics = {
        "Accuracy": accuracy_score(y_test, predictions),
        "Precision": precision_score(
            y_test, predictions, zero_division=0
        ),
        "Recall": recall_score(
            y_test, predictions, zero_division=0
        ),
        "F1 Score": f1_score(
            y_test, predictions, zero_division=0
        ),
        "ROC AUC": roc_auc_score(y_test, probabilities),
        "PR AUC": average_precision_score(y_test, probabilities)
    }

    results[name] = metrics
    trained_models[name] = model

    print(pd.Series(metrics))

# Select best model based on PR AUC
best_model_name = max(
    results,
    key=lambda name: results[name]["PR AUC"]
)

best_model = trained_models[best_model_name]

print("\nBest Model:", best_model_name)

# Save trained model
joblib.dump({
    "model": best_model,
    "features": FEATURES,
    "threshold": 0.50,
    "model_name": best_model_name
}, MODEL_PATH)

# Final predictions
final_probabilities = best_model.predict_proba(X_test)[:, 1]
final_predictions = (final_probabilities >= 0.50).astype(int)

# Classification report
print("\nClassification Report:")
print(classification_report(
    y_test,
    final_predictions,
    zero_division=0
))

# Confusion matrix
cm = confusion_matrix(y_test, final_predictions)

plt.figure(figsize=(7, 5))

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Blues",
    xticklabels=["Legitimate", "Fraud"],
    yticklabels=["Legitimate", "Fraud"]
)

plt.xlabel("Predicted")
plt.ylabel("Actual")
plt.title("Credit Card Fraud Detection")

plt.tight_layout()
plt.savefig("reports/confusion_matrix.png")
plt.close()

# Save evaluation results
report = {
    "best_model": best_model_name,
    "metrics": results,
    "fraud_rate": float(y.mean()),
    "total_transactions": len(df)
}

with open("reports/metrics.json", "w") as f:
    json.dump(report, f, indent=4)

print("\nModel training completed!")
print("Model saved:", MODEL_PATH)
print("Reports saved in reports/")

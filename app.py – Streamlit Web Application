
import streamlit as st
import pandas as pd
import joblib
import os

# Page configuration
st.set_page_config(
    page_title="Credit Card Fraud Detection",
    page_icon="💳",
    layout="wide"
)

st.title("💳 Credit Card Fraud Detection System")

st.write(
    "Machine Learning based credit card transaction "
    "fraud detection application."
)

MODEL_PATH = "models/fraud_model.joblib"

# Check trained model
if not os.path.exists(MODEL_PATH):
    st.error("Model not found. Please run train.py first.")
    st.stop()

# Load trained model
artifact = joblib.load(MODEL_PATH)
model = artifact["model"]
features = artifact["features"]
default_threshold = artifact.get("threshold", 0.50)

st.sidebar.header("Transaction Details")

# Input fields
amount = st.sidebar.number_input(
    "Transaction Amount",
    min_value=0.0,
    value=100.0
)

time_value = st.sidebar.number_input(
    "Transaction Time",
    min_value=0.0,
    value=10000.0
)

threshold = st.sidebar.slider(
    "Fraud Detection Threshold",
    min_value=0.01,
    max_value=0.99,
    value=float(default_threshold)
)

st.subheader("Enter Transaction Features")

values = {
    "Time": time_value,
    "Amount": amount
}

# Input V1 to V28
cols = st.columns(4)

for i in range(1, 29):
    with cols[(i - 1) % 4]:
        values[f"V{i}"] = st.number_input(
            f"V{i}",
            value=0.0,
            step=0.1
        )

# Prediction button
if st.button("Predict Transaction", type="primary"):

    input_data = pd.DataFrame(
        [[values[col] for col in features]],
        columns=features
    )

    # Predict probability
    probability = model.predict_proba(input_data)[0][1]

    # Classify transaction
    prediction = int(probability >= threshold)

    st.divider()

    st.subheader("Prediction Result")

    st.metric(
        "Fraud Probability",
        f"{probability * 100:.2f}%"
    )

    if prediction == 1:

        st.error("⚠️ FRAUDULENT TRANSACTION DETECTED")

        st.warning(
            "This transaction is flagged for further review."
        )

    else:

        st.success("✅ LEGITIMATE TRANSACTION")

        st.info(
            "The model did not flag this transaction "
            "at the selected threshold."
        )

    st.write("Model:", artifact["model_name"])

    st.caption(
        "Educational prediction only. This application "
        "must not be used to approve or reject real payments."
    )

st.divider()

st.subheader("About the Project")

st.write("""
This application uses Machine Learning algorithms
to identify potentially fraudulent credit card transactions.

Algorithms:
1. Logistic Regression
2. Random Forest

Evaluation:
- Precision
- Recall
- F1 Score
- ROC-AUC
- PR-AUC
""")
